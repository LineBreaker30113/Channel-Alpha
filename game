package GameCharactersAndEquipmentSystem;

public class ChatGpt {

	public class Assignment01_StudentNumber {

		    public static void main(String[] args) {
		        // Create Items
		        Assignment01_StudentNumber.Item sword = new Assignment01_StudentNumber.Item("Sword", "ATTACK", 10);
		        Assignment01_StudentNumber.Item bow = new Assignment01_StudentNumber.Item("Bow", "ATTACK", 8);
		        Assignment01_StudentNumber.Item staff = new Assignment01_StudentNumber.Item("Magic Staff", "ATTACK", 12);
		        
		        // Create Characters
		        Assignment01_StudentNumber.Warrior warrior = new Assignment01_StudentNumber.Warrior("Arthur", 100, 15, 5.0);
		        Assignment01_StudentNumber.Mage mage = new Assignment01_StudentNumber.Mage("Merlin", 80, 10, 50);
		        Assignment01_StudentNumber.Archer archer = new Assignment01_StudentNumber.Archer("Legolas", 90, 12, 85);
		        
		        // Add Items to Inventory
		        warrior.addItemToInventory(sword);
		        archer.addItemToInventory(bow);
		        mage.addItemToInventory(staff);
		        
		        // Equip Items
		        warrior.equipItemFromInventory(0);
		        archer.equipItemFromInventory(0);
		        mage.equipItemFromInventory(0);
		        
		        // Characters Attack
		        warrior.warriorAttack(mage);
		        mage.mageAttack(archer);
		        archer.archerAttack(warrior);
		        
		        // Unequip Item
		        warrior.unequipItem(0);
		    }
		
	    // Item Class
	    static class Item {
	        private String name;
	        private String bonusType;
	        private int bonusValue;

	        public Item(String name, String bonusType, int bonusValue) {
	            this.name = name;
	            this.bonusType = bonusType;
	            this.bonusValue = bonusValue;
	        }

	        public String getName() { return name; }
	        public String getBonusType() { return bonusType; }
	        public int getBonusValue() { return bonusValue; }

	        @Override
	        public String toString() {
	            return name + " [" + bonusType + " Bonus: " + bonusValue + "]";
	        }
	    }

	    // Character Base Class
	    static class Character {
	        protected String name;
	        protected int health;
	        protected int attackPower;
	        protected Item[] inventory;
	        protected Item[] equipment;
	        protected int inventoryCapacity;
	        protected int equipmentCapacity;

	        public Character(String name, int health, int attackPower, int inventorySize, int equipmentSize) {
	            this.name = name;
	            this.health = health;
	            this.attackPower = attackPower;
	            this.inventoryCapacity = inventorySize;
	            this.equipmentCapacity = equipmentSize;
	            this.inventory = new Item[inventorySize];
	            this.equipment = new Item[equipmentSize];
	        }

	        public int getTotalAttackPower() {
	            int totalAttack = attackPower;
	            for (Item item : equipment) {
	                if (item != null && "ATTACK".equals(item.getBonusType())) {
	                    totalAttack += item.getBonusValue();
	                }
	            }
	            return totalAttack;
	        }

	        public void takeDamage(int damage) {
	            health = Math.max(0, health - damage);
	            System.out.println(name + " takes " + damage + " damage. Current Health: " + health);
	        }

	        public void addItemToInventory(Item item) {
	            for (int i = 0; i < inventoryCapacity; i++) {
	                if (inventory[i] == null) {
	                    inventory[i] = item;
	                    System.out.println(name + " added " + item.getName() + " to inventory.");
	                    return;
	                }
	            }
	            System.out.println("Inventory is full!");
	        }
	        public void equipItemFromInventory(int invIndex) {
	            if (invIndex >= 0 && invIndex < inventoryCapacity && inventory[invIndex] != null) {
	                for (int i = 0; i < equipmentCapacity; i++) {
	                    if (equipment[i] == null) {
	                        equipment[i] = inventory[invIndex];
	                        System.out.println(name + " equips " + inventory[invIndex].getName() + " from inventory.");
	                        inventory[invIndex] = null;
	                        return;
	                    }
	                }
	                System.out.println("No available equipment slots!");
	            } else {
	                System.out.println("Invalid inventory index or item does not exist.");
	            }
	        }

	        public void removeItemFromInventory(int index) {
	            if (index < 0 || index >= inventoryCapacity || inventory[index] == null) {
	                System.out.println("Invalid index or empty slot!");
	                return;
	            }

	            System.out.println(name + " removed " + inventory[index].getName() + " from inventory.");

	            // Öğeyi kaldır ve diğerlerini sola kaydır
	            for (int i = index; i < inventoryCapacity - 1; i++) {
	                inventory[i] = inventory[i + 1];
	            }

	            // Son elemanı null yap (çünkü en son eleman bir sola kaymış oldu)
	            inventory[inventoryCapacity - 1] = null;
	        }

	        public void unequipItem(int equipIndex) {
	            if (equipIndex >= 0 && equipIndex < equipmentCapacity && equipment[equipIndex] != null) {
	                for (int i = 0; i < inventoryCapacity; i++) {
	                    if (inventory[i] == null) {
	                        inventory[i] = equipment[equipIndex];
	                        System.out.println(name + " removes " + equipment[equipIndex].getName() + " from equipment.");
	                        equipment[equipIndex] = null;
	                        return;
	                    }
	                }
	                System.out.println("Inventory is full! Cannot unequip item.");
	            } else {
	                System.out.println("Invalid equipment index or no item equipped.");
	            }
	        }
	    }

	    // Warrior Class
	    static class Warrior extends Character {
	        private double armor;

	        public Warrior(String name, int health, int attackPower, double armor) {
	            super(name, health, attackPower, 6, 3);
	            this.armor = armor;
	        }

	        public void warriorAttack(Character target) {
	            int totalAttackPower = getTotalAttackPower();
	            System.out.println(name + " attacks " + target.name + " with " + totalAttackPower + " attack power.");
	            target.takeDamage(totalAttackPower);
	        }
	    }

	    // Mage Class
	    static class Mage extends Character {
	        private int mana;

	        public Mage(String name, int health, int attackPower, int mana) {
	            super(name, health, attackPower, 2, 1);
	            this.mana = mana;
	        }

	        public void mageAttack(Character target) {
	            int totalAttackPower = getTotalAttackPower();
	            if (mana >= 10) {
	                totalAttackPower += 5;
	                mana -= 10;
	                System.out.println(name + " casts a spell on " + target.name + " dealing " + totalAttackPower + " damage. Mage's Remaining Mana: " + mana);
	            } else {
	                System.out.println(name + " attacks " + target.name + " with " + totalAttackPower + " attack power.");
	            }
	            target.takeDamage(totalAttackPower);
	        }
	    }

	    // Archer Class
	    static class Archer extends Character {
	        private int accuracy;

	        public Archer(String name, int health, int attackPower, int accuracy) {
	            super(name, health, attackPower, 4, 2);
	            this.accuracy = accuracy;
	        }

	        public void archerAttack(Character target) {
	            int totalAttackPower = getTotalAttackPower();
	            if (accuracy > 80) {
	                totalAttackPower += 5;
	                System.out.println(name + " performs a critical hit on " + target.name + " dealing " + totalAttackPower + " damage.");
	            } else {
	                System.out.println(name + " attacks " + target.name + " with " + totalAttackPower + " attack power.");
	            }
	            target.takeDamage(totalAttackPower);
	        }
	    }
	}

}
